DB_URL=jdbc:postgresql://localhost:5432/expense_management
DB_USERNAME=postgres
DB_PASSWORD=changeme
# ^ DB_URL above is for running the app directly on your host (mvn spring-boot:run).
# docker-compose.yml overrides it to point at the "postgres" service instead -
# you don't need to change it when using Docker.

JWT_SECRET=replace-with-a-random-32plus-character-secret
JWT_EXPIRATION_MINUTES=60

# Set to "local" for human-readable console logs during development.
# Leave unset (or any other value) in production to get structured JSON logs.
SPRING_PROFILES_ACTIVE=local
