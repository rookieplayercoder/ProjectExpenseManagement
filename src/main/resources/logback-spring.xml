<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <springProfile name="!local">
        <!-- Production/default: one JSON object per log line, ready for log
             aggregators (CloudWatch, ELK, Loki, etc). MDC fields (requestId,
             httpMethod, path, status, durationMs, userId) are included
             automatically because they're put into MDC by RequestLoggingFilter. -->
        <appender name="JSON_CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="net.logstash.logback.encoder.LogstashEncoder">
                <includeMdcKeyName>requestId</includeMdcKeyName>
                <includeMdcKeyName>httpMethod</includeMdcKeyName>
                <includeMdcKeyName>path</includeMdcKeyName>
                <includeMdcKeyName>status</includeMdcKeyName>
                <includeMdcKeyName>durationMs</includeMdcKeyName>
                <includeMdcKeyName>userId</includeMdcKeyName>
                <customFields>{"service":"expense-management"}</customFields>
            </encoder>
        </appender>

        <root level="INFO">
            <appender-ref ref="JSON_CONSOLE" />
        </root>
    </springProfile>

    <springProfile name="local">
        <!-- Local dev: human-readable console output instead of raw JSON. -->
        <appender name="PLAIN_CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>%d{HH:mm:ss.SSS} %-5level [%X{requestId}] %logger{36} - %msg%n</pattern>
            </encoder>
        </appender>

        <root level="INFO">
            <appender-ref ref="PLAIN_CONSOLE" />
        </root>
    </springProfile>

</configuration>
